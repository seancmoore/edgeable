rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Length helpers — server-side caps so a direct SDK write can't stuff
    // arbitrarily long strings into free-text fields.
    function strMax(v, n) {
      return v is string && v.size() <= n;
    }
    function optStrMax(data, key, n) {
      return !(key in data) || (data[key] is string && data[key].size() <= n);
    }
    // Required non-empty string within [min, max] length.
    function reqStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // ── users ────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Open self-signup: must claim own UID, role=user, status=inactive.
      // Accounts stay inactive until the admin approves a payment, so the
      // transaction/subscription request is the real verification gate.
      // Email, Telegram username, and phone are all required at signup.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'inactive'
        && reqStr(request.resource.data.displayName, 1, 80)
        && reqStr(request.resource.data.email, 3, 254)
        && reqStr(request.resource.data.telegramUsername, 5, 32)
        && reqStr(request.resource.data.phone, 7, 20)
        && optStrMax(request.resource.data, 'authEmail', 254);

      // Subscribers can self-update only:
      //  * unitSize (preference)
      //  * phone (Account page self-service; paired with the owner-scoped
      //    phones/{phone} delete + create below so login lookup stays in sync)
      //  * email/authEmail, but ONLY to the caller's own live Auth token email
      //    (self-heal after a verifyBeforeUpdateEmail change confirmed on
      //    /auth-action — nothing spoofable, the token is ground truth)
      // Everything else (status, subscription dates, role, etc.) requires admin.
      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == uid
            && (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unitSize'])
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone'])
                  && reqStr(request.resource.data.phone, 7, 20))
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'authEmail'])
                  && request.resource.data.email == request.auth.token.email
                  && request.resource.data.authEmail == request.auth.token.email)
            ));
      allow delete: if isAdmin();
    }

    // ── lookup collections (uniqueness + login lookup) ──────
    // Public single-doc reads allow login lookup before auth.
    // List/query is denied so nobody can dump all usernames/phones.
    // Create is constrained to {uid, authEmail} for the caller's own uid so the
    // docs can't be stuffed with extra data.
    // Owner self-heal (Account page): the doc's owner may refresh ONLY the
    // authEmail field, and only to their own live Auth token email. Squatting
    // stays blocked: you can never touch a doc whose uid isn't yours, and
    // create still fails on existing docs.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'authEmail'])
        && optStrMax(request.resource.data, 'authEmail', 254);
      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authEmail'])
            && request.resource.data.authEmail == request.auth.token.email);
      allow delete: if isAdmin();
    }

    // Phone move (Account page self-service) = owner delete of their own doc
    // + create of the new number with their own uid (create rule above the
    // dash unchanged). A number owned by someone else can't be deleted or
    // overwritten. Owner authEmail self-heal mirrors usernames.
    match /phones/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'authEmail'])
        && optStrMax(request.resource.data, 'authEmail', 254);
      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authEmail'])
            && request.resource.data.authEmail == request.auth.token.email);
      allow delete: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.uid);
    }

    // ── referral codes (uniqueness + code→uid lookup) ───────
    // Read is signed-in only (resolved during signup, which is authenticated —
    // no public exposure). List denied so codes can't be dumped. A user claims
    // exactly one code for their own uid at signup; admin manages the rest
    // (backfill runs via Admin SDK and bypasses rules).
    match /referralCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow update, delete: if isAdmin();
    }

    // ── config (payment info, etc.) ─────────────────────────
    // Payment info needs to be readable by subscribers so they can see
    // the Cashapp/Zelle recipients on the renewal request form.
    match /config/paymentInfo {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /config/{doc} {
      allow read, write: if isAdmin();
    }

    // ── transactions ─────────────────────────────────────────
    match /transactions/{txnId} {
      // Admin reads all + writes. Subscribers can read only their own.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.subscriberUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── profile change requests ──────────────────────────────
    match /profileChangeRequests/{reqId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.subscriberUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.subscriberUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && strMax(request.resource.data.proposedValue, 254)
        && optStrMax(request.resource.data, 'field', 40)
        && optStrMax(request.resource.data, 'currentValue', 254)
        && optStrMax(request.resource.data, 'reason', 200)
        && optStrMax(request.resource.data, 'notes', 1000)
        && optStrMax(request.resource.data, 'subscriberDisplayName', 80);
      allow update, delete: if isAdmin();
    }

    // ── transaction requests ─────────────────────────────────
    match /transactionRequests/{reqId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.subscriberUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.subscriberUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && optStrMax(request.resource.data, 'notes', 1000)
        && optStrMax(request.resource.data, 'paymentReference', 200)
        && optStrMax(request.resource.data, 'paymentMethod', 20)
        && optStrMax(request.resource.data, 'proofImageUrl', 2000)
        && optStrMax(request.resource.data, 'proofImagePath', 500)
        && optStrMax(request.resource.data, 'subscriberDisplayName', 80)
        && optStrMax(request.resource.data, 'subscriberTelegramUsername', 32);
      allow update, delete: if isAdmin();
    }

    // ── daily P&L entries ────────────────────────────────────
    // Readable by anyone signed in — inactive users can see the full track
    // record (a teaser); the app separates "your subscription performance"
    // from all-time. Write only by admin.
    match /dailyPnL/{day} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── public daily P&L mirror (landing page, 2026-08) ──────
    // World-readable numeric mirror of dailyPnL for the anonymous landing
    // page chart/ROI. Fields: units, wins, losses, pushes, stakedUnits ONLY
    // (never notes). Written by admins in the same batch as the dailyPnL doc
    // (src/utils/pnl.js savePnLEntry); backfilled by
    // scripts/backfill-public-pnl.js.
    match /dailyPnLPublic/{day} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // ── landing summary (single doc, 2026-08) ────────────────
    // landingStats/current is the ONE doc the anonymous landing page reads:
    // raw numbers only (units series, net/staked totals, W-L-P record, up to
    // 3 free-pick samples). Rebuilt by admin write paths (src/utils/pnl.js,
    // scripts/add-pnl-day.js) and scripts/rebuild-landing-stats.js.
    // dailyPnLPublic above stays world-readable as the raw source of truth
    // this summary is derived from.
    match /landingStats/{docId} {
      allow get: if true;
      allow write: if isAdmin();
    }

    // ── picks (tamper-evident pick record, tiered access) ────
    // Tamper-evidence contract:
    //  * writes pinned to the owner's UID + admin role
    //  * immutable after create except status+gradedAt (grading)
    //  * postedAt is always the server clock; grading is one-way; no deletes
    //  * every pick MUST have a world-readable picksPublic/{same id} stub
    //    (created + graded in the same batch, enforced via getAfter both ways)
    //    so no pick — and no loss — can ever be hidden from the public record
    // Access tiers (Phase 5 decision, 2026-07-17):
    //  * full pick details: active subscribers; access=='public' picks are
    //    readable by any signed-in user; details NEVER become world-readable
    //  * everyone: the picksPublic stub (everything except the description)
    // NOTE: the Admin SDK (service-account key) bypasses rules — this contract
    // binds the app and anyone talking to Firestore with client credentials.
    function isOwner() {
      return isAdmin() && request.auth.uid == '1lBW1ipOh3XHhGiKoJs6uKvbAAI2';
    }
    // Active subscriber = status active AND subscription not expired.
    // subscriptionEnd is ground truth (maintained by the transaction engine);
    // the status check additionally excludes paused accounts.
    function isActiveSubscriber() {
      return isSignedIn() && subIsActive(request.auth.uid);
    }
    function subIsActive(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return u.status == 'active'
        && u.subscriptionEnd is timestamp
        && u.subscriptionEnd > request.time;
    }
    match /picks/{pickId} {
      // Full details: owner, active subscribers, or ANYONE (including
      // unauthenticated visitors, for the landing page's free-pick samples,
      // 2026-08) for access=='public' picks. List queries for public picks
      // must filter where('access','==','public') so the rule is provable.
      allow get, list: if isOwner()
        || isActiveSubscriber()
        || resource.data.access == 'public';

      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(
             ['sport', 'description', 'odds', 'stakeUnits',
              'gameStartTime', 'postedAt', 'status', 'gradedAt', 'access'])
        && reqStr(request.resource.data.sport, 2, 20)
        && reqStr(request.resource.data.description, 3, 200)
        && request.resource.data.odds is int
        && (request.resource.data.odds >= 100 || request.resource.data.odds <= -100)
        && request.resource.data.stakeUnits is number
        && request.resource.data.stakeUnits > 0
        && request.resource.data.stakeUnits <= 100
        && request.resource.data.gameStartTime is timestamp
        && request.resource.data.gameStartTime > request.time
        && request.resource.data.postedAt == request.time
        && request.resource.data.status == 'pending'
        && request.resource.data.gradedAt == null
        && request.resource.data.access in ['public', 'subscribers']
        // the public stub must be created in the same batch (pairing is
        // cross-checked field-by-field in the stub's own create rule)
        && getAfter(/databases/$(database)/documents/picksPublic/$(pickId)).data.postedAt == request.time;

      // Grading: pending -> final, once. Nothing else may ever change.
      // The public stub must be graded to the same result in the same batch.
      allow update: if isOwner()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status', 'gradedAt'])
        && request.resource.data.status in ['win', 'loss', 'push', 'void']
        && request.resource.data.gradedAt == request.time
        && getAfter(/databases/$(database)/documents/picksPublic/$(pickId)).data.status == request.resource.data.status;

      allow delete: if false;
    }

    // World-readable stub: existence, timestamps, and result ONLY (Sean's
    // call, 2026-07-17: no sport/odds/stake indication per pick in public).
    // Proves the pick count, posted-before-game timing, and W-L record to
    // everyone; units/ROI are computable only by subscribers from full picks.
    match /picksPublic/{pickId} {
      allow get, list: if true;

      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(
             ['gameStartTime', 'postedAt', 'status', 'gradedAt'])
        && request.resource.data.postedAt == request.time
        && request.resource.data.status == 'pending'
        && request.resource.data.gradedAt == null
        // must mirror the full pick created in the same batch (types/bounds
        // are already enforced by the pick's own create rule)
        && getAfter(/databases/$(database)/documents/picks/$(pickId)).data.postedAt == request.time
        && getAfter(/databases/$(database)/documents/picks/$(pickId)).data.gameStartTime == request.resource.data.gameStartTime;

      allow update: if isOwner()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status', 'gradedAt'])
        && request.resource.data.status in ['win', 'loss', 'push', 'void']
        && request.resource.data.gradedAt == request.time
        && getAfter(/databases/$(database)/documents/picks/$(pickId)).data.status == request.resource.data.status;

      allow delete: if false;
    }

    // ── account events (audit log) ───────────────────────────
    match /accountEvents/{eventId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.subscriberUid == request.auth.uid);
      // Subscribers can only log events on their own account, with performedBy=subscriber.
      // Admin operations write via Admin SDK (script/function), bypassing rules.
      allow create: if isSignedIn()
        && request.resource.data.subscriberUid == request.auth.uid
        && request.resource.data.performedBy == 'subscriber'
        && optStrMax(request.resource.data, 'subscriberDisplayName', 80);
      allow update, delete: if isAdmin();
    }
  }
}
